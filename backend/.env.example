# --- Conexão com o Supabase (Postgres) ---
# DATABASE_URL: usada pela aplicação em tempo de execução (via pooler/Supavisor, porta 6543)
# DIRECT_URL: usada apenas pelo Prisma CLI para migrations (conexão direta, porta 5432)
#
# Pegue os dois valores no painel do Supabase: Project Settings > Database > Connect > aba "ORM" > Prisma
# --- Conexão com o Supabase (Postgres) ---
# DATABASE_URL: usada pela aplicação em tempo de execução, via pooler/Supavisor (porta 6543)
#   Pegue em: Connect > aba "ORM" > Prisma > primeira string (Transaction pooler)
# DIRECT_URL: usada apenas pelo Prisma CLI para migrations — é a conexão DIRETA, sem pooler
#   Pegue em: Connect > aba "Direct connection" (host começa com "db.", porta 5432, usuário só "postgres")
DATABASE_URL="postgres://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJECT-REF].supabase.co:5432/postgres"

# Segredo usado para assinar os tokens JWT (troque por um valor aleatório e seguro)
JWT_SECRET="troque-este-valor-por-uma-string-aleatoria-e-secreta"

# --- Supabase Storage (upload de fotos) ---
# SUPABASE_URL: em Project Settings > Data API > Project URL
# SUPABASE_SERVICE_ROLE_KEY: em Project Settings > API Keys > service_role (secreta! nunca exponha no front-end)
SUPABASE_URL="https://[SEU-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SUA-SERVICE-ROLE-KEY]"
SUPABASE_STORAGE_BUCKET="servitrack-fotos"

# Porta em que a API vai rodar
PORT=3333

# Em produção: URL(s) do frontend que podem acessar esta API, separadas por vírgula.
# Em desenvolvimento local, pode deixar em branco (libera qualquer origem).
CORS_ORIGIN=https://github.com/Paias83/servitrack.git
